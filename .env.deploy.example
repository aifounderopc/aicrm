# docker-compose 部署用环境变量。复制为 .env 并填写真实值
# 生成密钥：
#   JWT_SECRET:     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   FIELD_ENC_KEY:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (必须 32 字节=64 hex)

# 数据库（自托管 db 服务用）
DB_USER=joycrm
DB_PASSWORD=请改成强密码
DB_NAME=joycrm

# 后端密钥
JWT_SECRET=请填64位以上随机hex
FIELD_ENC_KEY=请填64位hex（32字节）

# 允许的前端来源（生产填你的域名，多个逗号分隔）
CORS_ORIGINS=https://crm.yourdomain.com

# 生产用 HTTPS 时置 true（cookie 仅 https 下发）
COOKIE_SECURE=true

# 首次部署置 true 写入初始管理员，之后改回 false
SEED_ON_START=true

# 对外端口（前端 Nginx）
WEB_PORT=80

# 飞书机器人（也可在系统“连接器 > 飞书 > 范围设置”中安全配置）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
