# 前端调用的 API 基础路径（相对路径，开发时由 Vite 代理转发）
VITE_API_BASE=/api

# 开发环境后端转发目标（仅本地开发用，被 vite.config.ts 读取）
# 默认 http://localhost:3000，如后端在内网改这里
DEV_API_TARGET=http://localhost:3000

# 启用真实后端 API（true=连后端，留空/false=本地 localStorage 演示模式）
VITE_USE_API=false

# 仅本地演示模式使用；真实环境账号密码由后端安全存储
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_CHANNEL_ADMIN_PASSWORD=
VITE_DEMO_SALES_ADMIN_PASSWORD=
VITE_DEMO_SALES_PASSWORD=
VITE_DEMO_CHANNEL_PASSWORD=
VITE_DEMO_JD_MANAGER_PASSWORD=
