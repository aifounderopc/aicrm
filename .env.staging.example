# docker-compose 预发环境变量。复制为 .env.staging 并填写真实值
# 生成密钥：
#   JWT_SECRET:     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   FIELD_ENC_KEY:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (必须 32 字节=64 hex)

# 数据库（预发环境独立使用，避免污染生产数据）
DB_USER=joycrm_staging
DB_PASSWORD=请改成预发强密码
DB_NAME=joycrm_staging

# 后端密钥（预发必须和生产不同）
JWT_SECRET=请填64位以上随机hex
FIELD_ENC_KEY=请填64位hex（32字节）

# 预发访问来源。若先用 IP + 8080 访问，填 http://117.72.47.155:8080
CORS_ORIGINS=http://117.72.47.155:8080

# 先用 IP/HTTP 访问时保持 false；绑定 HTTPS 域名后再改 true
COOKIE_SECURE=false

# 首次搭建预发可置 true 写入演示账号；之后改回 false
SEED_ON_START=true

# 预发前端对外端口，避免占用生产 80
WEB_PORT=8080
